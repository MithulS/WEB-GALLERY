# Pic Web server environment variables
# Copy this file to .env and fill in the required values.
# Do not commit .env to source control.

# Required: MongoDB connection string (mongodb-memory-server is used for local dev/tests)
MONGO_URI=mongodb://127.0.0.1:27017/picweb

# Required: Server port
PORT=5000

# Required: JWT signing secret (at least 32 characters)
JWT_SECRET=replace-with-at-least-32-random-characters

# Required: Allowed CORS origin for the frontend
CLIENT_ORIGIN=http://localhost:5173
CLIENT_URL=http://localhost:5173

# Optional: Google OAuth client ID (needed for Google login or Photos import)
GOOGLE_CLIENT_ID=

# Optional: Google OAuth client secret (needed for Google login or Photos import)
GOOGLE_CLIENT_SECRET=

# Google login and Google Photos must use separate registered redirect URIs.
GOOGLE_AUTH_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
GOOGLE_PHOTOS_REDIRECT_URI=http://localhost:5000/api/google/callback

# Optional: AES-256-GCM key to encrypt Google refresh tokens (at least 32 chars, needed only for Google import)
GOOGLE_TOKEN_ENCRYPTION_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-gmail-app-password
MAIL_FROM=Pic Web <your-gmail-address@gmail.com>
